# ===== ChatMate Server Environment =====
#
# Copy this file to `.env` and adjust the values for your environment.
# All values below are for LOCAL DEVELOPMENT with the built-in JSON file
# store and disk uploads.
#
# ── Core ───────────────────────────────────────────────
# The port the local HTTP + Socket.IO server listens on.
PORT=4000
# Base URL of this server (used for absolute file URLs / emails).
PUBLIC_URL=http://localhost:4000

# ── Security ───────────────────────────────────────────
# Secret used to sign JWT access & refresh tokens.
# Change on first deployment. Leave blank locally to use development-only
# defaults (`dev-access-secret` / `dev-refresh-secret`). The server refuses
# to start in production unless these are set to unique values of at least
# 32 characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Access token lifetime, e.g. 15m / 1h / 7d
JWT_ACCESS_TTL=15m
# Refresh token lifetime
JWT_REFRESH_TTL=30d

# ── Administrator bootstrap ────────────────────────────
# Set this to an existing account email to grant the first administrator role.
ADMIN_EMAIL=admin@example.com

# ── Frontend — comma-separated allowed origins ─────────
# IMPORTANT: in production, set this to the EXACT Netlify site origin (and any
# custom domain). Do not use `http://localhost:5173` in production.
# Example: https://app.netlify.app,https://www.your-domain.com
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://your-site.netlify.app

# ── Storage ────────────────────────────────────────────
# LOCAL DEVELOPMENT ONLY.
# The current application uses a synchronous JSON file store and local-disk
# uploads. These are NOT durable or safe on serverless / multi-instance
# hosting. See README.md for the production storage migration.
DB_FILE=./data/app.json
UPLOAD_DIR=./uploads

# ── Email (password reset / verification) ───────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=secret
# MAIL_FROM="ChatMate <noreply@example.com>"

# ── Google OAuth (for /auth/google) ─────────────────────
# The /auth/google endpoint now FAILS CLOSED until server-side Google ID token
# verification is configured with real credentials. Uncomment and fill in once
# you have a Google OAuth 2.0 Client ID / Secret:
#
# GOOGLE_CLIENT_ID=652786587051-xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# GOOGLE_CALLBACK_URL=https://api.your-domain.example.com/api/auth/google/callback
