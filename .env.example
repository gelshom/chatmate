# ===== ChatMate Server Environment =====
# Copy this file to `.env` and adjust values for your environment.

# --- Core ---
# The port the local HTTP + Socket.IO server listens on.
PORT=4000
# Base URL of this server (used for building absolute file URLs / emails).
PUBLIC_URL=http://localhost:4000

# --- Security ---
# Secret used to sign JWT access & refresh tokens (change in production!).
# Generate separate random secrets for production (at least 32 characters).
# Leave blank locally to use the development-only defaults.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Access token lifetime, e.g. 15m / 1h / 7d
JWT_ACCESS_TTL=15m
# Refresh token lifetime
JWT_REFRESH_TTL=30d

# --- Administrator bootstrap ---
# Set this to an existing account email to grant the first administrator role.
ADMIN_EMAIL=admin@example.com

# --- Frontend ---
# Comma-separated allowed frontend origins. For production, include your exact
# Netlify site origin (and custom domain if used), without a trailing slash.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://your-site.netlify.app

# --- Storage ---
# Local development only: the current application uses a synchronous JSON file
# store. This is not safe/persistent on serverless or multi-instance hosting.
DB_FILE=./data/app.json
# Local development only: uploads are written to disk and served from /uploads.
UPLOAD_DIR=./uploads

# --- Email (for password reset / verification) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=secret
# MAIL_FROM="ChatMate <noreply@example.com>"

# --- Optional 2FA provider key (Speakeasy default is fine) ---
# OTP_ISSUER=ChatMate
